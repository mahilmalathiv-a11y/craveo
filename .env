# Environment Configurations for FoodOrderingAI

SECRET_KEY=django-insecure-ai-delivery-engine-secret-key-12345
DEBUG=True

# Database Configuration
# Set USE_MYSQL to True to connect to MySQL database. Make sure the database exists.
# Set USE_MYSQL to False to run locally on SQLite.
USE_MYSQL=False

DB_NAME=food_delivery_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
